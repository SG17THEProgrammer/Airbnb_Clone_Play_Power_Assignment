{
  "compilerOptions": {
    "target": "ES2017", // which JavaScript version to compile to 
    "lib": ["dom", "dom.iterable", "esnext"], // which built-in APIs exist
                                  //newest JavaScript features
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true, // enables all strict type-checking rules
    "noEmit": true, // doesn't generate any JavaScript from TS
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler", // Controls how imports are resolved
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx", // Controls how JSX is transformed ; no need of import React from "react";
    "incremental": true,
    "plugins": [
      {
        "name": "next" //Enables the Next.js TypeScript plugin
      }
    ],
    "paths": {
      "@/*": ["./src/*"] // alias
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
